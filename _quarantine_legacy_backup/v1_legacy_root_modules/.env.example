# Environment Variables for Explainable AI in Education Dashboard

# Database Configuration
DATABASE_URL=sqlite:///./edurisk.db

# Application Settings
APP_NAME="Explainable AI in Education"
APP_VERSION="1.0.0"
DEBUG_MODE=True

# Data Source Paths
DEFAULT_RAW_DATA_PATH=data/raw/
DEFAULT_PROCESSED_DATA_PATH=data/processed/

# Model Path Configuration
MODEL_REGISTRY_PATH=models/
CURRENT_MODEL_PATH=models/current/
MODEL_VERSIONS_PATH=models/versions/

# Random Seed for Reproducibility
RANDOM_SEED=42
